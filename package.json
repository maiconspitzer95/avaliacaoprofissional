{
  "name": "avaliacao-desempenho",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k \"node --watch server.js\" \"vite --config client/vite.config.js --configLoader native\"",
    "build": "vite build --config client/vite.config.js --configLoader native",
    "migrate": "node server/src/database/migrate.js",
    "seed": "node server/src/database/seeds/master.js",
    "inspect-db": "node server/src/database/inspect.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
